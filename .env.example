# ORO CRM — konfigurasjon
# Kopier denne filen til .env og fyll inn verdier

# Server-port (standard: 3001)
PORT=3001

# PostgreSQL-tilkobling (påkrevd)
#
# Lokalt: bruk DATABASE_PUBLIC_URL fra Railway → Postgres → Variables
DATABASE_URL=postgresql://postgres:PASSORD@host:PORT/railway
#
# På Railway (produksjon): bruk intern tilkobling i stedet for public proxy.
# Aktiver "Private Networking" i Railway-prosjektet, legg til tjenesten i
# samme private nettverk, og sett DATABASE_PRIVATE_URL til verdien av
# DATABASE_PRIVATE_URL fra Railway → Postgres → Variables.
# Når denne er satt brukes den fremfor DATABASE_URL og SSL slås av (ikke nødvendig internt).
# Public proxy (DATABASE_URL) kan da skrus av i Railway uten at driften påvirkes.
DATABASE_PRIVATE_URL=

# Miljø: "production" aktiverer CORS fail-closed og krever ALLOWED_ORIGIN
NODE_ENV=development

# Tillatt origin for CORS (påkrevd i production, valgfri i development)
# Sett til Railway-domenet ditt, f.eks. https://oro-crm-production.up.railway.app
ALLOWED_ORIGIN=

# Admin-konto (opprettes automatisk hvis ingen brukere finnes i databasen)
# Utelates disse genereres et tilfeldig passord som skrives til server-loggen
CRM_USER=admin
CRM_PASS=
CRM_DISPLAY_NAME=Admin
